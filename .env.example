# Copy to .env and fill in your values (e.g. from Fly secrets or your saved config).

# Database (Postgres on Fly or local)
DATABASE_URI=

# Payload
PAYLOAD_SECRET=

# Cloudflare R3 / S3-compatible storage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=

# Stripe 
# These should be test keys in dev, live keys in prod. In RegistrationForm.tsx, best to update the publishable key fallback when using production keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (signup confirmation email). If unset, no confirmation email is sent.
# NOTE: During O-Week, daily signups will exceed the free tier limit (100/day).
# Upgrade to a paid Resend plan for the month of O-Week, then downgrade — free tier
# is sufficient for the rest of the year.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Sheets (registration data is synced to a shared spreadsheet for exec visibility)
# Service account on the shared TANSA Gmail. The sheet ID stays the same year over year —
# at yearly reset, copy the spreadsheet as an archive, then clear the original's tabs.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Exec O-Week dashboard (URL-only, not in nav). Shared password for /exec/dashboard.
EXEC_DASHBOARD_PASSWORD=

# Site URL (used in confirmation emails). Set to https://tansa.co.nz in production.
NEXT_PUBLIC_SITE_URL=